          }
        },
        {
          "usedBy": {
            "description": "An open source ISA software suite and an extensible hierarchical data structure implemented by a growing number of international public resources. It caters to data as diverse as stem cell, toxicogenomics, environmental gene surveys, microbial diversity studies, and a variety of metabolomics and metagenomics-based studies. But it maintains cross-domain compatibility in the way the experimental context is described.",
            "homepage": "http://isa-tools.org",
            "label": "ISA software suite",
            "type": "application",
