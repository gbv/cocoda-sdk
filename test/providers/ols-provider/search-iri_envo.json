        {
          "usedBy": {
            "description": "FAIR WISH will (1) develop standardised and discipline specific IGSN metadata schemes for different samples types within the research field Earth and Environment (EaE) that are complementing the core IGSN metadata schema; and (2) develop workflows to generate machine-readable IGSN metadata from different states of digitisation (from templates to databases) and to automatically register IGSNs.",
            "homepage": "https://helmholtz-metadaten.de/en/inf-projects/fair-wish",
            "label": "FAIR Wish",
            "provider": [
